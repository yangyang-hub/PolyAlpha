{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "概览",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "资产总额 (USDC)",
      "description": "USDC 余额 + 持仓敞口",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "green", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "usdc_balance / 1e6 + total_exposure_usd", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "USDC 余额",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "usdc_balance / 1e6", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "已实现盈亏 (USDC)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 7, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "realized_pnl_usd", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "总敞口 (USDC)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 10000,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3000 },
              { "color": "orange", "value": 5000 },
              { "color": "red", "value": 8000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "total_exposure_usd", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "熔断器",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "正常", "color": "green" }, "1": { "text": "已触发", "color": "red" } }, "type": "value" }
          ],
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "circuit_breaker_active", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "监控市场",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 17, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "monitored_markets", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "WS 订阅",
      "type": "stat",
      "gridPos": { "h": 4, "w": 2, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "active_ws_subscriptions", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "做市市场",
      "type": "stat",
      "gridPos": { "h": 4, "w": 2, "x": 22, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "thresholds": { "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "value", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "lr_active_markets", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "title": "资产组合",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "资产组合走势",
      "description": "资产总额 = USDC 余额 + 持仓敞口",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "资产总额" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "white", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "USDC 余额" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 20 },
              { "id": "custom.stacking", "value": { "mode": "normal" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "持仓敞口" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 20 },
              { "id": "custom.stacking", "value": { "mode": "normal" } }
            ]
          }
        ]
      },
      "targets": [
        { "expr": "usdc_balance / 1e6", "legendFormat": "USDC 余额", "refId": "A" },
        { "expr": "total_exposure_usd", "legendFormat": "持仓敞口", "refId": "B" },
        { "expr": "usdc_balance / 1e6 + total_exposure_usd", "legendFormat": "资产总额", "refId": "C" }
      ]
    },
    {
      "title": "盈亏与余额趋势 (USDC)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme",
            "showPoints": "never"
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "USDC 余额" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 5 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "已实现盈亏" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "总敞口" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "targets": [
        { "expr": "usdc_balance / 1e6", "legendFormat": "USDC 余额", "refId": "A" },
        { "expr": "realized_pnl_usd", "legendFormat": "已实现盈亏", "refId": "B" },
        { "expr": "total_exposure_usd", "legendFormat": "总敞口", "refId": "C" }
      ]
    },
    {
      "title": "交易管道",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "机会漏斗 (速率/秒)",
      "description": "检测 → 拒绝 → 执行 → 错误",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "检测" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "拒绝" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "执行" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "错误" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "rate(opportunities_detected_total[5m])", "legendFormat": "检测", "refId": "A" },
        { "expr": "rate(opportunities_rejected_total[5m])", "legendFormat": "拒绝", "refId": "B" },
        { "expr": "rate(executions_total[5m])", "legendFormat": "执行", "refId": "C" },
        { "expr": "rate(execution_errors_total[5m])", "legendFormat": "错误", "refId": "D" }
      ]
    },
    {
      "title": "退出 / 事件过滤 / 深度验证",
      "description": "退出交易、事件日历过滤、深度验证（缩减与拒绝）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "退出交易" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "事件过滤" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "深度缩减" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "深度拒绝" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "rate(exit_trades_total[5m]) * 300", "legendFormat": "退出交易", "refId": "A" },
        { "expr": "rate(event_filter_applied_total[5m]) * 300", "legendFormat": "事件过滤", "refId": "B" },
        { "expr": "rate(depth_validation_scaled_total[5m]) * 300", "legendFormat": "深度缩减", "refId": "C" },
        { "expr": "rate(depth_validation_rejected_total[5m]) * 300", "legendFormat": "深度拒绝", "refId": "D" }
      ]
    },
    {
      "title": "延迟",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "执行延迟 (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(execution_latency_seconds_bucket[5m]))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(execution_latency_seconds_bucket[5m]))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(execution_latency_seconds_bucket[5m]))", "legendFormat": "P99", "refId": "C" }
      ]
    },
    {
      "title": "策略扫描延迟",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(scan_latency_seconds_bucket[5m])",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "color": { "scheme": "Oranges" }
      }
    },
    {
      "title": "基础设施",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "WebSocket 重连",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(ws_reconnect_total[5m]) * 300", "legendFormat": "重连次数 / 5分钟", "refId": "A" }
      ]
    },
    {
      "title": "快照录制",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "super-light-blue", "mode": "fixed" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(snapshots_recorded_total[5m]) * 60", "legendFormat": "快照数 / 分钟", "refId": "A" }
      ]
    },
    {
      "title": "做市订单",
      "description": "做市后台任务的下单与撤单",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "bars",
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "下单" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "撤单" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "rate(lr_orders_placed_total[5m]) * 300", "legendFormat": "下单", "refId": "A" },
        { "expr": "rate(lr_orders_cancelled_total[5m]) * 300", "legendFormat": "撤单", "refId": "B" },
        { "expr": "rate(lr_fills_detected_total[5m]) * 300", "legendFormat": "成交", "refId": "C" },
        { "expr": "rate(lr_fill_requotes_total[5m]) * 300", "legendFormat": "补单", "refId": "D" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["polyalpha", "trading"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PolyAlpha 总览",
  "uid": "polyalpha-overview",
  "version": 3
}
