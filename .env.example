# PolyAlpha 环境变量
# 复制为 .env 并填入你的值。切勿提交 .env 到版本控制！

# ═══════════════════════════════════════════════════════════════════════
# 后端（Rust Bot）
# ═══════════════════════════════════════════════════════════════════════
#
# 后端配置采用分层加载（优先级从高到低）：
#   1. 环境变量 PA_* 前缀（双下划线分隔嵌套，如 PA_CHAIN__RPC_URL）
#   2. config/{RUN_MODE}.toml
#   3. config/default.toml
#
# 下方列出需要通过环境变量设置的项（敏感信息不应写入 TOML）。
# 其余配置项见 config/default.toml，均可通过 PA_* 环境变量覆盖。

# ── 运行模式 ──
# 决定加载哪个 config/{RUN_MODE}.toml 文件
RUN_MODE=default                    # default | production | testnet

# ── Polygon 链 ──
PA_CHAIN__RPC_URL=https://polygon-rpc.com

# ── 数据库（仅回测需要，实盘不需要）──
# PA_DATABASE__URL=postgresql://polyalpha:polyalpha@localhost:5432/polyalpha

# ── 日志级别 ──
RUST_LOG=info                       # trace | debug | info | warn | error

# ── 监控 Webhook（可选）──
# PA_MONITOR__ALERT_WEBHOOK=https://hooks.slack.com/services/xxx

# ── 外部 API Key（可选，按需启用）──
# PA_CRYPTO_ALPHA__COINGECKO_API_KEY=CG-xxxx           # CoinGecko Demo API Key
# PA_EVENT_CALENDAR__FINNHUB_API_KEY=xxxx               # Finnhub 宏观经济日历
# PA_EVENT_CALENDAR__COINMARKETCAL_API_KEY=xxxx         # CoinMarketCal 加密事件

# ─────────────────────────────────────────────────────────────────────
# 账户配置
# ─────────────────────────────────────────────────────────────────────
#
# 支持两种模式：
#   A) 单账户（Legacy）— 不设 PA_ACCOUNT_* 变量，使用下方 POLYMARKET_PRIVATE_KEY
#   B) 多账户 — 设置 PA_ACCOUNT_<N>_* 变量，Legacy 配置被忽略
#
# 可用策略:
#   weather, crypto, convergence    — 方向性 Alpha
#   smart_money                     — 智能钱包跟单
#   liquidity_rewards               — 流动性奖励做市

# ── A) 单账户模式 ──
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here
PA_CLOB__SIGNATURE_TYPE=2           # 0=EOA, 1=Proxy, 2=GnosisSafe
PA_CLOB__PROXY_WALLET=0x_your_proxy_wallet_address

# ── B) 多账户模式 ──
# 索引从 1 开始，必须连续（跳号即停止扫描）。
# 每个账户字段:
#   NAME            (必填) 唯一标识符，显示在日志中
#   PRIVATE_KEY_ENV (选填) 持有私钥的环境变量名，默认 POLYMARKET_PRIVATE_KEY
#   SIGNATURE_TYPE  (选填) 0=EOA, 1=Proxy, 2=GnosisSafe，默认 0
#   PROXY_WALLET    (选填) Polymarket 代理钱包地址，默认使用 EOA
#   STRATEGIES      (选填) 逗号分隔的策略列表，默认无

# 私钥（每个账户一个独立的环境变量）
# POLYMARKET_PRIVATE_KEY=0x_account1_private_key
# POLYMARKET_PRIVATE_KEY_2=0x_account2_private_key

# 账户 1: 方向性策略
# PA_ACCOUNT_1_NAME=main
# PA_ACCOUNT_1_PRIVATE_KEY_ENV=POLYMARKET_PRIVATE_KEY
# PA_ACCOUNT_1_SIGNATURE_TYPE=2
# PA_ACCOUNT_1_PROXY_WALLET=0x_proxy_wallet_1
# PA_ACCOUNT_1_STRATEGIES=weather,crypto,convergence

# 账户 2: 流动性奖励
# PA_ACCOUNT_2_NAME=lr_bot
# PA_ACCOUNT_2_PRIVATE_KEY_ENV=POLYMARKET_PRIVATE_KEY_2
# PA_ACCOUNT_2_SIGNATURE_TYPE=2
# PA_ACCOUNT_2_PROXY_WALLET=0x_proxy_wallet_2
# PA_ACCOUNT_2_STRATEGIES=liquidity_rewards

# ═══════════════════════════════════════════════════════════════════════
# 前端（Vite + React SPA）
# ═══════════════════════════════════════════════════════════════════════
#
# 前端无需额外环境变量。
#
# 生产模式：前端静态文件由后端 Axum 服务器托管（同源），
#           API 请求直接发往同一 host:port（默认 18381）。
#
# 开发模式：npm run dev 启动 Vite 开发服务器（端口 5173），
#           vite.config.ts 中的 proxy 自动将 /api、/health、/ready、
#           /metrics 请求代理到 http://localhost:18381（后端）。
#           如需修改后端地址，编辑 frontend/vite.config.ts 的 proxy 配置。
