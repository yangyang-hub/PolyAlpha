# PolyAlpha Environment Variables
# Copy to .env and fill in your values. NEVER commit .env!

# ═══════════════════════════════════════════════════════════════
# Core Settings
# ═══════════════════════════════════════════════════════════════

# RPC endpoint (Polygon mainnet)
PA_CHAIN__RPC_URL=https://polygon-rpc.com

# Run mode: default, production, testnet
RUN_MODE=default

# Database (only needed for backtest, not for live trading)
PA_DATABASE__URL=postgresql://polyalpha:polyalpha@localhost:5432/polyalpha

# Monitoring alerts (optional)
PA_MONITOR__ALERT_WEBHOOK=

# ═══════════════════════════════════════════════════════════════
# Single Account (Legacy Mode)
# ═══════════════════════════════════════════════════════════════
# If no PA_ACCOUNT_* variables are set, this is used as the sole account.
# It runs all strategies listed in [strategy].enabled + LR if enabled.

POLYMARKET_PRIVATE_KEY=0x_your_private_key_here
PA_CLOB__SIGNATURE_TYPE=2
PA_CLOB__PROXY_WALLET=0x_your_proxy_wallet_address

# ═══════════════════════════════════════════════════════════════
# Multi-Account Mode
# ═══════════════════════════════════════════════════════════════
# Define multiple accounts with PA_ACCOUNT_<N>_* variables.
# Each account has its own wallet, risk limits, and assigned strategies.
# Indices start at 1 and must be sequential (gap = stop scanning).
#
# When PA_ACCOUNT_1_NAME is set, the legacy single-account config above
# is ignored. Each account still reads its private key from the env var
# named in PRIVATE_KEY_ENV (not directly from this variable).
#
# Fields:
#   NAME           (required)  Unique identifier, shown in logs
#   PRIVATE_KEY_ENV (optional) Env var name holding the hex private key
#                              Default: POLYMARKET_PRIVATE_KEY
#   SIGNATURE_TYPE  (optional) 0=EOA, 1=Proxy, 2=GnosisSafe. Default: 0
#   PROXY_WALLET    (optional) Polymarket proxy wallet address. Default: EOA
#   STRATEGIES      (optional) Comma-separated strategy list. Default: none
#
# Available strategies:
#   weather, crypto, convergence    — directional alpha
#   smart_money                     — copy-trading
#   liquidity_rewards               — passive LR quoting

# ── Private keys (one per account) ──
POLYMARKET_PRIVATE_KEY=0x_account1_private_key
POLYMARKET_PRIVATE_KEY_2=0x_account2_private_key
POLYMARKET_PRIVATE_KEY_3=0x_account3_private_key

# ── Account 1: directional strategies ──
PA_ACCOUNT_1_NAME=main
PA_ACCOUNT_1_PRIVATE_KEY_ENV=POLYMARKET_PRIVATE_KEY
PA_ACCOUNT_1_SIGNATURE_TYPE=2
PA_ACCOUNT_1_PROXY_WALLET=0x_proxy_wallet_1
PA_ACCOUNT_1_STRATEGIES=weather,crypto,convergence

# ── Account 2: liquidity rewards only ──
PA_ACCOUNT_2_NAME=lr_bot
PA_ACCOUNT_2_PRIVATE_KEY_ENV=POLYMARKET_PRIVATE_KEY_2
PA_ACCOUNT_2_SIGNATURE_TYPE=2
PA_ACCOUNT_2_PROXY_WALLET=0x_proxy_wallet_2
PA_ACCOUNT_2_STRATEGIES=liquidity_rewards

# ── Account 3: crypto + LR (same strategy, different wallet) ──
PA_ACCOUNT_3_NAME=alt
PA_ACCOUNT_3_PRIVATE_KEY_ENV=POLYMARKET_PRIVATE_KEY_3
PA_ACCOUNT_3_SIGNATURE_TYPE=2
PA_ACCOUNT_3_PROXY_WALLET=0x_proxy_wallet_3
PA_ACCOUNT_3_STRATEGIES=crypto,liquidity_rewards
